{
  "rewrites": [
    {
      "source": "/((?!assets|favicon\\.ico|favicon\\.png|ac\\.png|carpentry\\.png|electrical\\.png|cleaning\\.png|painting\\.png|plumbing\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
